# ─── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SERVICE_NAME=cidb-tender-api
# Public origin of the deployment, e.g. https://cidb-tender-api.onrender.com.
# Advertised in the OpenAPI `servers` at /docs; empty = relative to this origin.
PUBLIC_BASE_URL=

# ─── Database (Neon PostgreSQL in production) ───────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/cidb?schema=public
# Optional pooled connection string (Neon pooler) for the API at scale.
DATABASE_URL_POOLED=
# DB_MODE=postgres (default, Prisma) or memory (in-process DB, LOCAL TESTING ONLY).
DB_MODE=postgres
# API only: run one sync on boot (dev convenience, usually with DB_MODE=memory).
# Booleans accept true/false, 1/0, yes/no, on/off (case-insensitive).
API_SYNC_ON_START=false

# ─── API authentication ─────────────────────────────────────────────────────
# Public/read API key consumed by TenderBase (sent as X-API-Key header).
# Generate with: npm run keys:hash -- "your-secret-key"
API_KEY=
# Admin key for /api/v1/admin/* and /api/v1/health/detailed.
ADMIN_API_KEY=

# ─── CIDB source / ingestion ────────────────────────────────────────────────
# The machine-readable feed the CIDB website renders its listing from.
# The human page (https://www.cidb.org.za/cidb-tenders/current-tenders/) builds its
# table in the browser, so its served HTML has an empty <tbody>: ingesting it yields
# zero records. Point CIDB_SOURCE_URL at an HTML listing only if CIDB ever
# server-renders it again.
# The feed is paginated server-side (?page=&limit=, total in `tender_count`), and a
# sync walks every page — a bare request returns only the first 25 of them.
# Offline testing (same pipeline): file:./tests/fixtures/cidb-tenders.json
CIDB_SOURCE_URL=https://www.cidb.org.za/tenders.json
# Feed page size (the site offers 10/25/50/100) and safety cap on pages per sync.
CIDB_FEED_PAGE_SIZE=100
CIDB_FEED_MAX_PAGES=50
# Public page every ingested record is attributed to (the API's sourceUrl field).
CIDB_LISTING_URL=https://www.cidb.org.za/cidb-tenders/current-tenders/
CIDB_SYNC_CRON=*/30 * * * *
# Run one sync immediately when the worker boots (default true).
SYNC_ON_START=true
# Mark tenders missing from the source as CLOSED after N days (0 disables).
MISSING_CLOSE_GRACE_DAYS=3
# Suspicious-result guards.
MIN_EXPECTED_RECORDS=1
MAX_DROP_RATIO=0.8
# Days before closingDate at which a tender is reported as CLOSING_SOON.
CLOSING_SOON_DAYS=7

# ─── HTTP client ────────────────────────────────────────────────────────────
REQUEST_TIMEOUT_MS=30000
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=1000
# Polite delay between sequential source requests.
REQUEST_DELAY_MS=1500
CIDB_USER_AGENT=CIDB-Tender-API/1.0 (+https://github.com/tenderbase; contact: TenderBase data service)

# ─── CORS (comma-separated allowlist; empty = cross-origin browser calls blocked) ─
# Server-to-server callers (no Origin header) are always allowed. Use * only locally.
CORS_ORIGIN=http://localhost:3000

# ─── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
ADMIN_RATE_LIMIT_MAX=60
ADMIN_RATE_LIMIT_WINDOW_MS=60000
